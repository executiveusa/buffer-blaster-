# ─────────────────────────────────────────────────────────────
#  CREATOR STUDIO — ENVIRONMENT VARIABLES
#  Copy to .env and fill values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Platform identity ─────────────────────────────────────
PLATFORM_NAME=Creator Studio
MASTER_ENCRYPTION_KEY=                             # openssl rand -hex 32

# ── Operating mode (frontend) ─────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional Stripe checkout ──────────────────────────────
# No Stripe npm package is required. The server route calls Stripe's HTTPS API
# only after a customer selects checkout. Configure either a Payment Link OR
# both the secret key and one-time Price ID.
STRIPE_FOUNDING_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_FOUNDING_PRICE_ID=

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI providers ──────────────────────────────────────────
ACTIVE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_AI_API_KEY=
GOOGLE_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ── Hermes agent ──────────────────────────────────────────
HERMES_PROFILE=creator-studio
HERMES_MAX_CHILDREN=10

# ── Video generation ──────────────────────────────────────
HIGGSFIELD_API_KEY=
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp

# ── Social publishing ─────────────────────────────────────
BUFFER_ACCESS_TOKEN=

# ── Research / scraping ───────────────────────────────────
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=

# ── Client data ───────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Voice control ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
VISIONCLAW_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com

# ── Deploy ────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
API_URL=http://localhost:8000

# ── GitHub ────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=executiveusa/buffer-blaster-
