# Buffer Blaster self-hosted backend
# Copy to .env.production. Never commit real values.

API_DOMAIN=api.example.com
ALLOWED_ORIGINS=https://your-frontend.example.com
PLATFORM_NAME=Buffer Blaster
SITE_URL=https://your-frontend.example.com

# Operator/security — install.sh generates core backend secrets if blank.
MASTER_ENCRYPTION_KEY=
# Legacy shared-password login: only served while this flag is set (default off). Prefer Supabase Auth.
DEMO_PASSWORD_LOGIN_ENABLED=false
DEMO_PASSWORD=
# Break-glass owner credential. Full rights; keep for recovery even with Supabase Auth on.
BLASTER_API_KEY=
# Supabase Auth (humans): GoTrue HS256 secret from the self-hosted stack (JWT_SECRET), never the anon/service key.
SUPABASE_JWT_SECRET=
# Optional: exact expected iss claim, e.g. http://supabase-kong:8000/auth/v1
SUPABASE_JWT_ISSUER=
# Comma-separated IPs of reverse proxies whose X-Forwarded-For is trusted (Next.js server / Caddy as seen by the API). Empty = trust none.
TRUSTED_PROXY_IPS=
# Agents: a scoped bba_ token issued via POST /api/agent/tokens. Set in the agent's own environment, never here.
# BLASTER_AGENT_TOKEN=
TRIAL_SESSION_SECRET=
REDIS_PASSWORD=
REDIS_URL=
MAX_REQUEST_BYTES=2000000

# API capacity
WEB_CONCURRENCY=4
UVICORN_LIMIT_CONCURRENCY=1000
UVICORN_BACKLOG=2048

# Canonical SELF-HOSTED Supabase ledger + private asset storage.
# Buffer Blaster API/worker run in Docker, so do not use 127.0.0.1/localhost here.
# Join the existing Supabase Docker network and address Kong by container DNS.
BUFFER_BLASTER_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
SUPABASE_DOCKER_NETWORK=supabase_default
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_SERVICE_KEY=
SUPABASE_PROJECT_REF=
# Frontend build-time public values for Supabase Auth sign-in (anon key is safe to expose; RLS applies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
BUFFER_BLASTER_ASSET_BUCKET=buffer-blaster-assets
ASSET_DOWNLOAD_MAX_BYTES=262144000

# Proof-first money loop. Live spend remains disabled until credentials are supplied
# and each launch/pause request carries explicit approved=true.
MONEY_LOOP_SYNC_INTERVAL_SECONDS=3600
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_API_BASE_URL=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=

# Optional downstream social publisher. Disabled unless explicitly selected.
# Buffer uses its current GraphQL API at https://api.buffer.com.
PUBLISHING_PROVIDER=
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=

# LLM provider
ACTIVE_LLM_PROVIDER=openai
AGENT_MAX_CHILDREN=10
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_AI_API_KEY=
GOOGLE_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# UGC/media through Fal. Keep model IDs and model-specific input capabilities env-driven.
FAL_KEY=
FAL_QUEUE_URL=https://queue.fal.run
FAL_TEXT_VIDEO_MODEL=minimax/h3-max/text-to-video
FAL_IMAGE_VIDEO_MODEL=minimax/h3-max/image-to-video
FAL_IMAGE_INPUT_FIELD=image_url
FAL_DURATION_TYPE=integer
FAL_AUDIO_INPUT_FIELD=
# Model-specific capabilities, fail-closed when unset (never rename the fields above):
# reference-to-video model with a LIST reference input (e.g. reference_image_urls on
# minimax/h3-max/reference-to-video), and a real audio-URL input (e.g. target_audio_url),
# distinct from the boolean generate_audio flag. Confirm the selected provider API schema before enabling.
FAL_REFERENCE_VIDEO_MODEL=
FAL_REFERENCE_IMAGES_FIELD=
FAL_AUDIO_URL_FIELD=
# Routes on which the audio-URL field above is accepted (comma-separated model
# ids). Env labels are plumbing, not vendor proof: declare only routes whose
# CURRENT docs name the field (verified 2026-11-10: minimax/h3-max
# text-to-video, image-to-video and reference-to-video all document
# target_audio_url - it REPLACES the generated soundtrack; it is not a
# lip-sync or voice input). Empty/unset = audio URLs never sent.
FAL_AUDIO_URL_MODELS=
FAL_VIDEO_RESOLUTION=
FAL_PROMPT_EXPANSION_MODE=
FAL_POLL_INTERVAL_SECONDS=2
FAL_RENDER_TIMEOUT_SECONDS=600
FACTORY_WORK_ROOT=/tmp/buffer-blaster-factory
KEEP_FACTORY_WORKFILES=false

# Server-owned generation allowance / provider-spend guard.
# These package values remain runtime economics; the public site does not expose them as low-ticket plans.
MIN_CONTRIBUTION_MARGIN_BPS=6000
PAYMENT_FEE_BPS=300
PAYMENT_FEE_FIXED_CENTS=30
INFRASTRUCTURE_RESERVE_BPS=500
RESEARCH_RESERVE_BPS=300
REFUND_RESERVE_BPS=500
STANDARD_AD_CREDIT_COST_CENTS=100
TRIAL_7_PRICE_CENTS=1900
TRIAL_7_INCLUDED_AD_CREDITS=3
TRIAL_7_PROVIDER_BUDGET_CENTS=400
TRIAL_30_PRICE_CENTS=4900
TRIAL_30_INCLUDED_AD_CREDITS=8
TRIAL_30_PROVIDER_BUDGET_CENTS=1100
STARTER_PRICE_CENTS=9900
STARTER_INCLUDED_AD_CREDITS=20
STARTER_PROVIDER_BUDGET_CENTS=2300
PRO_PRICE_CENTS=19900
PRO_INCLUDED_AD_CREDITS=50
PRO_PROVIDER_BUDGET_CENTS=4700
UGC_FACTORY_CLIP_COST_CENTS=80
UGC_FACTORY_EXPECTED_CLIPS_PER_AD=3
UGC_FACTORY_COST_SAFETY_BPS=12500
UGC_FACTORY_PRICE_CENTS=9900

# Optional Stripe checkout compatibility. The public site no longer presents these as the primary offer.
STRIPE_SECRET_KEY=
STRIPE_TRIAL_7_PRICE_ID=
STRIPE_TRIAL_7_PAYMENT_LINK=
STRIPE_TRIAL_30_PRICE_ID=
STRIPE_TRIAL_30_PAYMENT_LINK=
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_PAYMENT_LINK=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PAYMENT_LINK=

# Universal video gateway. Set ACTIVE_MEDIA_PROVIDER=gateway to route the existing
# UGC factory through any compatible async video gateway without changing business logic.
# Works with OpenAI-style gateways (for example MediaRouter/AngeMedia/YoloRouter) and
# MuAPI-style Open-Higgsfield flows through configurable endpoint/auth templates.
ACTIVE_MEDIA_PROVIDER=fal
GENERATION_GATEWAY_NAME=
GENERATION_GATEWAY_BASE_URL=
GENERATION_GATEWAY_API_KEY=
GENERATION_GATEWAY_TEXT_VIDEO_MODEL=
GENERATION_GATEWAY_IMAGE_VIDEO_MODEL=
# Comma-separated server allowlist. Example: seedance-2.5,kling-3.0,veo-3.1
GENERATION_GATEWAY_ALLOWED_MODELS=
GENERATION_GATEWAY_SUBMIT_PATH=/v1/videos
GENERATION_GATEWAY_STATUS_PATH=/v1/videos/{id}
GENERATION_GATEWAY_POLL_METHOD=GET
GENERATION_GATEWAY_AUTH_HEADER=Authorization
GENERATION_GATEWAY_AUTH_PREFIX=Bearer 
GENERATION_GATEWAY_MODEL_IN_BODY=true
GENERATION_GATEWAY_IMAGE_INPUT_FIELD=image_url
# Model-specific list/audio-URL capabilities, fail-closed when unset:
GENERATION_GATEWAY_REFERENCE_IMAGES_FIELD=
GENERATION_GATEWAY_AUDIO_URL_FIELD=
# Gateway routes accepting the audio-URL field (comma-separated). Same rule:
# declare only routes whose current docs name the field; empty = never sent.
GENERATION_GATEWAY_AUDIO_URL_MODELS=
GENERATION_GATEWAY_DURATION_FIELD=duration
GENERATION_GATEWAY_ASPECT_RATIO_FIELD=aspect_ratio
GENERATION_GATEWAY_AUDIO_FIELD=generate_audio
GENERATION_GATEWAY_EXTRA_BODY_JSON={}
# Provider capability configuration; confirm current API schemas before enabling:
# fal minimax/h3-max supports 16:9, 9:16, 1:1, 3:4 (4:5 NOT listed) - set these to the ACTUAL
# configured model's capabilities; the preflight waste guard blocks anything outside them.
GENERATION_GATEWAY_SUPPORTED_RATIOS=9:16,16:9,1:1
GENERATION_GATEWAY_SUPPORTED_DURATIONS_SECONDS=5,10,15,30
GENERATION_GATEWAY_MAX_REFERENCE_IMAGES=1
GENERATION_GATEWAY_ESTIMATED_CLIP_COST_CENTS=80
# Optional per-model cents-per-clip estimates. Any non-default override without a cost is rejected before wallet reservation.
GENERATION_GATEWAY_MODEL_COSTS_JSON={}
GENERATION_GATEWAY_ESTIMATED_LATENCY_SECONDS=
GENERATION_GATEWAY_COMMERCIAL_USE_STATUS=review_required
GENERATION_GATEWAY_COMMERCIAL_USE_APPROVED=false
GENERATION_GATEWAY_QUALITY_RANK=60
GENERATION_GATEWAY_COST_CLASS=standard
GENERATION_GATEWAY_DEPLOYMENT=hosted

# Open-Higgsfield / MuAPI example:
# ACTIVE_MEDIA_PROVIDER=gateway
# GENERATION_GATEWAY_NAME=muapi
# GENERATION_GATEWAY_BASE_URL=https://api.muapi.ai
# GENERATION_GATEWAY_AUTH_HEADER=x-api-key
# GENERATION_GATEWAY_AUTH_PREFIX=
# GENERATION_GATEWAY_SUBMIT_PATH=/api/v1/{model}
# GENERATION_GATEWAY_STATUS_PATH=/api/v1/predictions/{id}/result
# GENERATION_GATEWAY_MODEL_IN_BODY=false
# GENERATION_GATEWAY_TEXT_VIDEO_MODEL=seedance-2.5
# GENERATION_GATEWAY_IMAGE_VIDEO_MODEL=seedance-2.5
# GENERATION_GATEWAY_ALLOWED_MODELS=seedance-2.5,kling-v3,veo3
# Exact IDs must match the configured gateway's current catalog.

# Optional legacy/alternate media integrations — not required by core.
HIGGSFIELD_API_KEY=
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp

# Research / scraping
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=

# Voice/control
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
VISIONCLAW_WEBHOOK_SECRET=

# Optional email/client integrations
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
GITHUB_TOKEN=
GITHUB_REPO=executiveusa/buffer-blaster-

# Footage connectors (S5) - secrets stay environment-managed
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
FOOTAGE_OAUTH_REDIRECT_BASE=https://your-host
FOOTAGE_IMPORT_MAX_BYTES=2000000000
FOOTAGE_IMPORT_ALLOWED_HOSTS=

# LLM pricing (S4 r3) - REQUIRED per active (provider, model); an unconfigured
# model is rejected before any provider call. Ground values in the vendor's
# current pricing page before enabling provider calls.
# Pattern: LLM_PRICE_{PROVIDER}_{MODEL_UPPER_UNDERSCORED}_{IN|OUT}_CENTS_PER_MTOK
# Example (Claude Fable 5.1 list price, 2026-11-10): $10/MTok in, $50/MTok out
# LLM_PRICE_ANTHROPIC_CLAUDE_FABLE_5_1_IN_CENTS_PER_MTOK=1000
# LLM_PRICE_ANTHROPIC_CLAUDE_FABLE_5_1_OUT_CENTS_PER_MTOK=5000
