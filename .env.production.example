# Stavarai / Buffer Blaster self-hosted backend
# Copy to .env.production. Never commit real values.

API_DOMAIN=api.example.com
ALLOWED_ORIGINS=https://stavarai-platform.vercel.app
PLATFORM_NAME=Stavarai

# Operator/security — install.sh generates these if blank.
MASTER_ENCRYPTION_KEY=
DEMO_PASSWORD=
BLASTER_API_KEY=
REDIS_PASSWORD=
MAX_REQUEST_BYTES=2000000

# API capacity knobs. Redis-backed sessions make these workers share auth state.
WEB_CONCURRENCY=4
UVICORN_LIMIT_CONCURRENCY=1000
UVICORN_BACKLOG=2048

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PROJECT_REF=cyxdevcjycmffhmwxojh

# LLM provider
ACTIVE_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_AI_API_KEY=
GOOGLE_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# UGC/media through Fal. Keep model IDs env-driven.
FAL_KEY=
FAL_QUEUE_URL=https://queue.fal.run
# Current quality candidates checked for beta: minimax/h3-max/*
# Faster alternative: minimax/hailuo-2.3-fast/*
FAL_TEXT_VIDEO_MODEL=minimax/h3-max/text-to-video
FAL_IMAGE_VIDEO_MODEL=minimax/h3-max/image-to-video

# Social publishing kernel
TRYPOST_URL=
TRYPOST_API_KEY=

# Optional legacy provider fallbacks
HIGGSFIELD_API_KEY=
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
BUFFER_ACCESS_TOKEN=

# Research / scraping
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=

# Voice/control
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
VISIONCLAW_WEBHOOK_SECRET=

# Optional commerce/email
STRIPE_SECRET_KEY=
STRIPE_FOUNDING_PAYMENT_LINK=
STRIPE_FOUNDING_PRICE_ID=
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com

# Optional integrations
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
GITHUB_TOKEN=
GITHUB_REPO=executiveusa/buffer-blaster-
